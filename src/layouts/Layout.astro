---
import '../styles/global.css';
import fs from 'node:fs';
import { ClientRouter } from 'astro:transitions';

const allPostsGlob = import.meta.glob('../pages/blog/*.md', { eager: true });
const allPosts = Object.values(allPostsGlob).sort((a: any, b: any) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));


interface Props {
	title: string;
	frontmatter?: any;
	headings?: { depth: number; slug: string; text: string }[];
}

const { title, frontmatter, headings } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const pageTitle = frontmatter?.title || title;
const description = frontmatter?.description || "Tech Rants and Build Logs of the heretic pleb";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hereticpleb.vercel.app');
const ogType = Astro.url.pathname.startsWith('/blog/') ? 'article' : 'website';
const ogImage = frontmatter?.image ? new URL(frontmatter.image, canonicalURL) : new URL('/og-image.jpg', canonicalURL);

let prevPost = null;
let nextPost = null;

if (frontmatter) {
	const currentIndex = allPosts.findIndex((p: any) => p.url === Astro.url.pathname);
	if (currentIndex !== -1) {
		nextPost = allPosts[currentIndex - 1]; // Newer post is earlier in sorted array
		prevPost = allPosts[currentIndex + 1]; // Older post is later in sorted array
	}
}

let readingTime = frontmatter?.readingTime;
if (!readingTime && frontmatter?.file) {
	try {
		const content = fs.readFileSync(frontmatter.file, 'utf-8');
		const wordCount = content.trim().split(/\s+/).length || 1;
		readingTime = Math.max(1, Math.ceil(wordCount / 200));
	} catch (e) {}
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:creator" content="@hereticpleb" />

		<!-- Theme & Author -->
		<meta name="author" content="Pranav Desai" />
		<meta name="theme-color" content="#000000" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />

		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5.3.0/400.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5.3.0/700.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/unifrakturcook@5.3.0/700.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.3.0/index.css" />

		<meta name="generator" content={Astro.generator} />
		<link rel="alternate" type="application/rss+xml" title="hereticpleb" href={new URL("rss.xml", Astro.site || "https://hereticpleb.vercel.app")} />
		<title>{pageTitle}</title>
		<ClientRouter />
		<script is:inline>
			function applyTheme() {
				const theme = (() => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					if (window.matchMedia('(prefers-color-scheme: light)').matches) {
						return 'light';
					}
					return 'dark';
				})();
				if (theme === 'light') {
					document.documentElement.classList.add('light-theme');
					const metaTheme = document.querySelector('meta[name="theme-color"]');
					if (metaTheme) metaTheme.setAttribute('content', '#faf8f5');
				} else {
					document.documentElement.classList.remove('light-theme');
					const metaTheme = document.querySelector('meta[name="theme-color"]');
					if (metaTheme) metaTheme.setAttribute('content', '#000000');
				}
			}
			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>
	<body>
		<div id="progress-bar"></div>
		<main>
			<nav class="site-nav">
				{!isHome && <a href="/">hereticpleb</a>}
				<a href="/rss.xml" class="rss-icon" aria-label="RSS Feed" title="RSS Feed">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 11a9 9 0 0 1 9 9"></path>
						<path d="M4 4a16 16 0 0 1 16 16"></path>
						<circle cx="5" cy="19" r="1"></circle>
					</svg>
				</a>
				<button id="theme-toggle" aria-label="Toggle light/dark mode" title="Toggle theme">
					<svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
					<svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				</button>
			</nav>
			
			{frontmatter && (
				<header style="text-align: center; margin-bottom: 3rem;">
					<h1 style="margin-bottom: 0.5rem;">{frontmatter.title}</h1>
					<div style="font-style: italic; opacity: 0.7; font-size: 0.9rem;">
						{new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
						{readingTime && <span> • {readingTime} min read</span>}
					</div>
				</header>
			)}

			<div class="article-content">
				{frontmatter && headings && headings.length > 0 && (
					<>
						<details class="toc-mobile hidden-desktop" id="mobile-toc" open>
							<summary><h2>table of contents</h2></summary>
							<ul class="toc-list">
								{headings.filter((h: any) => h.depth > 1).map((h: any) => (
									<li class={`depth-${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</details>
						<script is:inline>
							if (window.innerWidth <= 750) {
								document.getElementById('mobile-toc')?.removeAttribute('open');
							}
						</script>
					</>
				)}
				<slot />
				
				{frontmatter && (
					<div class="post-footer-links" style="margin-top: 4rem; text-align: center;">
						<hr style="margin-bottom: 2rem;" />
						<p style="margin-bottom: 1.5rem; font-size: 1.1rem; text-align: center;">Enjoyed this post?</p>
						<div style="margin-bottom: 2.5rem;">
							<a href="/rss.xml" class="rss-icon" aria-label="RSS Feed" title="RSS Feed" style="display: inline-flex; align-items: center; gap: 0.5rem; font-weight: bold; font-size: 1.2rem; text-decoration: none;">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 11a9 9 0 0 1 9 9"></path>
									<path d="M4 4a16 16 0 0 1 16 16"></path>
									<circle cx="5" cy="19" r="1"></circle>
								</svg>
								<span style="text-decoration: underline; text-decoration-color: var(--accent-color); text-underline-offset: 4px; text-decoration-thickness: 1px;">Subscribe via RSS</span>
							</a>
						</div>
						<div class="footer-social-container" style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
							<span style="opacity: 0.8;">Follow along:</span>
							<div class="footer-social-links" style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
								<a href="https://github.com/PranavDesai-Git" target="_blank" rel="noopener noreferrer" style="font-weight: 500;">GitHub</a>
								<span class="footer-social-bullet" style="opacity: 0.5;">&bull;</span>
								<a href="https://www.linkedin.com/in/pranav-desai-542961385/" target="_blank" rel="noopener noreferrer" style="font-weight: 500;">LinkedIn</a>
								<span class="footer-social-bullet" style="opacity: 0.5;">&bull;</span>
								<a href="https://x.com/hereticpleb" target="_blank" rel="noopener noreferrer" style="font-weight: 500;">Twitter</a>
								<span class="footer-social-bullet" style="opacity: 0.5;">&bull;</span>
								<a href="mailto:hereticplebeian@gmail.com" style="font-weight: 500;">Email</a>
							</div>
						</div>
					</div>
				)}

				{frontmatter && (prevPost || nextPost) && (
					<div class="post-navigation">
						<hr />
						<div class="nav-links">
							{prevPost && (
								<a href={prevPost.url} class="nav-prev">
									<span class="nav-label">← Previous Article</span>
									<span class="nav-title">{prevPost.frontmatter.title}</span>
								</a>
							)}
							{nextPost && (
								<a href={nextPost.url} class="nav-next">
									<span class="nav-label">Next Article →</span>
									<span class="nav-title">{nextPost.frontmatter.title}</span>
								</a>
							)}
						</div>
					</div>
				)}
			</div>

			{frontmatter && headings && headings.length > 0 && (
				<aside class="toc-desktop hidden-mobile">
					<h2>Contents</h2>
					<ul class="toc-list">
						{headings.filter((h: any) => h.depth > 1).map((h: any) => (
							<li class={`depth-${h.depth}`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</aside>
			)}

			{Astro.url.pathname !== '/privacy' && Astro.url.pathname !== '/privacy/' && (
				<footer style="text-align: center; margin-top: 4rem; padding-bottom: 2rem; font-size: 0.9rem; opacity: 0.6;">
					<a href="/privacy" style="color: inherit; text-decoration: underline;">Privacy Policy</a>
				</footer>
			)}
		</main>

		<button id="back-to-top" aria-label="Back to top">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
		</button>

		<div id="search-modal" class="search-modal hidden">
			<div class="search-modal-content">
				<input type="text" id="search-input" placeholder="Search articles... (Cmd/Ctrl + K to close)" />
				<ul id="search-results"></ul>
			</div>
		</div>

		<script>
			document.addEventListener('astro:page-load', () => {
			const progressBar = document.getElementById('progress-bar');
			const topBtn = document.getElementById('back-to-top');

			window.addEventListener('scroll', () => {
				// Progress Bar
				const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = (winScroll / height) * 100;
				if (progressBar) progressBar.style.width = scrolled + '%';

				// Back to top button
				if (winScroll > 500) {
					if (topBtn) {
						topBtn.style.opacity = '0.7';
						topBtn.style.pointerEvents = 'auto';
					}
				} else {
					if (topBtn) {
						topBtn.style.opacity = '0';
						topBtn.style.pointerEvents = 'none';
					}
				}
			});

			if (topBtn) {
				topBtn.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}

			const themeToggle = document.getElementById('theme-toggle');
			if (themeToggle) {
				themeToggle.addEventListener('click', () => {
					document.documentElement.classList.toggle('light-theme');
					const isLight = document.documentElement.classList.contains('light-theme');
					localStorage.setItem('theme', isLight ? 'light' : 'dark');
					const metaTheme = document.querySelector('meta[name="theme-color"]');
					if (metaTheme) metaTheme.setAttribute('content', isLight ? '#faf8f5' : '#000000');
				});
			}
				// Scroll-Spy TOC
				const headings = document.querySelectorAll('.article-content h2, .article-content h3');
				const tocLinks = document.querySelectorAll('.toc-list a');
				if (headings.length && tocLinks.length) {
					const observer = new IntersectionObserver(entries => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								tocLinks.forEach(link => {
									link.classList.remove('active');
									if (link.getAttribute('href') === '#' + entry.target.id) {
										link.classList.add('active');
									}
								});
							}
						});
					}, { rootMargin: '-10% 0px -80% 0px' });
					headings.forEach(h => observer.observe(h));
				}

				// Copy Button for Code Blocks
				const preBlocks = document.querySelectorAll('pre');
				preBlocks.forEach(pre => {
					if (pre.querySelector('.copy-btn')) return;
					pre.style.position = 'relative';
					const btn = document.createElement('button');
					btn.className = 'copy-btn';
					btn.textContent = 'Copy';
					btn.addEventListener('click', () => {
						const code = pre.querySelector('code')?.innerText || pre.innerText;
						navigator.clipboard.writeText(code).then(() => {
							btn.textContent = 'Copied!';
							setTimeout(() => btn.textContent = 'Copy', 2000);
						});
					});
					pre.appendChild(btn);
				});

				// Fullscreen Image Click
				const images = document.querySelectorAll('.article-content img');
				images.forEach(img => {
					img.style.cursor = 'zoom-in';
					img.addEventListener('click', () => {
						const overlay = document.createElement('div');
						overlay.style.position = 'fixed';
						overlay.style.top = '0';
						overlay.style.left = '0';
						overlay.style.width = '100vw';
						overlay.style.height = '100vh';
						overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.9)';
						overlay.style.zIndex = '9999';
						overlay.style.display = 'flex';
						overlay.style.justifyContent = 'center';
						overlay.style.alignItems = 'center';
						
						const closeBtn = document.createElement('button');
						closeBtn.innerHTML = '&times;';
						closeBtn.style.position = 'absolute';
						closeBtn.style.top = '20px';
						closeBtn.style.right = '30px';
						closeBtn.style.fontSize = '40px';
						closeBtn.style.color = '#fff';
						closeBtn.style.background = 'transparent';
						closeBtn.style.border = 'none';
						closeBtn.style.cursor = 'pointer';
						closeBtn.style.lineHeight = '1';
						closeBtn.style.padding = '10px';
						closeBtn.style.zIndex = '10000';
						closeBtn.setAttribute('aria-label', 'Close fullscreen image');
						
						const zoomInBtn = document.createElement('button');
						zoomInBtn.innerHTML = '+';
						zoomInBtn.style.position = 'absolute';
						zoomInBtn.style.top = '20px';
						zoomInBtn.style.right = '110px';
						zoomInBtn.style.fontSize = '40px';
						zoomInBtn.style.color = '#fff';
						zoomInBtn.style.background = 'transparent';
						zoomInBtn.style.border = 'none';
						zoomInBtn.style.cursor = 'pointer';
						zoomInBtn.style.lineHeight = '1';
						zoomInBtn.style.padding = '10px';
						zoomInBtn.style.zIndex = '10000';
						zoomInBtn.setAttribute('aria-label', 'Zoom in');

						const zoomOutBtn = document.createElement('button');
						zoomOutBtn.innerHTML = '&minus;';
						zoomOutBtn.style.position = 'absolute';
						zoomOutBtn.style.top = '20px';
						zoomOutBtn.style.right = '70px';
						zoomOutBtn.style.fontSize = '40px';
						zoomOutBtn.style.color = '#fff';
						zoomOutBtn.style.background = 'transparent';
						zoomOutBtn.style.border = 'none';
						zoomOutBtn.style.cursor = 'pointer';
						zoomOutBtn.style.lineHeight = '1';
						zoomOutBtn.style.padding = '10px';
						zoomOutBtn.style.zIndex = '10000';
						zoomOutBtn.setAttribute('aria-label', 'Zoom out');
						
						const clone = document.createElement('img');
						clone.src = img.src;
						clone.style.maxWidth = '95vw';
						clone.style.maxHeight = '95vh';
						clone.style.objectFit = 'contain';
						clone.style.boxShadow = '0 0 20px rgba(0,0,0,0.5)';
						clone.style.cursor = 'grab';
						clone.style.transition = 'transform 0.1s ease-out';
						
						overlay.appendChild(zoomInBtn);
						overlay.appendChild(zoomOutBtn);
						overlay.appendChild(closeBtn);
						overlay.appendChild(clone);
						document.body.appendChild(overlay);
						
						let scale = 1;
						let isDragging = false;
						let startX = 0, startY = 0, translateX = 0, translateY = 0;
						
						const updateTransform = () => {
							clone.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
						};

						zoomInBtn.addEventListener('click', (e) => {
							e.stopPropagation();
							scale = Math.min(scale + 0.5, 10);
							updateTransform();
						});

						zoomOutBtn.addEventListener('click', (e) => {
							e.stopPropagation();
							scale = Math.max(scale - 0.5, 0.5);
							updateTransform();
						});
						
						clone.addEventListener('wheel', (e) => {
							e.preventDefault();
							scale += e.deltaY * -0.005;
							scale = Math.min(Math.max(0.5, scale), 10); // scale between 0.5x and 10x
							updateTransform();
						});
						
						clone.addEventListener('mousedown', (e) => {
							e.preventDefault();
							isDragging = true;
							startX = e.clientX - translateX;
							startY = e.clientY - translateY;
							clone.style.cursor = 'grabbing';
							clone.style.transition = 'none'; // remove transition for smooth dragging
						});
						
						window.addEventListener('mouseup', () => {
							if (isDragging) {
								isDragging = false;
								clone.style.cursor = 'grab';
								clone.style.transition = 'transform 0.1s ease-out';
							}
						});
						
						window.addEventListener('mousemove', (e) => {
							if (!isDragging) return;
							e.preventDefault();
							translateX = e.clientX - startX;
							translateY = e.clientY - startY;
							updateTransform();
						});
						
						overlay.addEventListener('click', (e) => {
							if (e.target === overlay || e.target === closeBtn) {
								if (document.body.contains(overlay)) {
									document.body.removeChild(overlay);
								}
							}
						});
					});
				});

				// Quick Search Modal
				let searchData = null;
				const searchModal = document.getElementById('search-modal');
				const searchInput = document.getElementById('search-input');
				const searchResults = document.getElementById('search-results');

				const handleKeydown = (e) => {
					if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
						e.preventDefault();
						if (searchModal) {
							searchModal.classList.toggle('hidden');
							if (!searchModal.classList.contains('hidden')) {
								searchInput.focus();
								if (!searchData) {
									fetch('/search.json').then(res => res.json()).then(data => searchData = data);
								}
							}
						}
					}
					if (e.key === 'Escape' && searchModal && !searchModal.classList.contains('hidden')) {
						searchModal.classList.add('hidden');
					}
				};

				document.removeEventListener('keydown', handleKeydown);
				document.addEventListener('keydown', handleKeydown);

				if (searchModal) {
					searchModal.addEventListener('click', (e) => {
						if (e.target === searchModal) searchModal.classList.add('hidden');
					});
				}

				if (searchInput && searchResults) {
					searchInput.addEventListener('input', (e) => {
						const q = e.target.value.toLowerCase();
						if (!q) {
							searchResults.innerHTML = '';
							return;
						}
						const filtered = searchData?.filter(post => post.title.toLowerCase().includes(q) || (post.description && post.description.toLowerCase().includes(q))) || [];
						searchResults.innerHTML = filtered.map(post => `
							<li><a href="${post.url}">
								<span class="search-title">${post.title}</span>
								<span class="search-desc">${post.description || ''}</span>
							</a></li>
						`).join('');
					});
				}


			});
		</script>
	</body>
</html>
