---
import '../styles/global.css';
import fs from 'node:fs';
import { getAbsoluteImageUrl } from '../utils/images';

interface Props {
	title: string;
	frontmatter?: any;
	description?: string;
}

const { title, frontmatter, description: descProp } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const pageTitle = frontmatter?.title || title;
const description = frontmatter?.description || descProp || "Tech Rants and Build Logs of godObject";
const siteURL = Astro.site || 'https://godobject.dev';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogType = Astro.url.pathname.startsWith('/blog/') ? 'article' : 'website';
const ogImageUrl = getAbsoluteImageUrl(frontmatter?.image, siteURL) || new URL('/og-image.jpg', siteURL).href;
const ogImageAlt = frontmatter?.imageAlt || frontmatter?.image?.alt || pageTitle;

let readingTime = frontmatter?.readingTime;
if (!readingTime && frontmatter?.file) {
	try {
		const content = fs.readFileSync(frontmatter.file, 'utf-8');
		const wordCount = content.trim().split(/\s+/).length || 1;
		readingTime = Math.max(1, Math.ceil(wordCount / 200));
	} catch (e) {}
}

const allPostsGlob = import.meta.glob('../pages/blog/*.md', { eager: true }) as Record<string, any>;
const allPosts = Object.values(allPostsGlob)
	.filter((p: any) => import.meta.env.DEV || !p.frontmatter?.draft)
	.sort((a: any, b: any) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));

let prevPost = null;
let nextPost = null;
if (frontmatter) {
	const currentPath = Astro.url.pathname.replace(/\/$/, '');
	const currentIndex = allPosts.findIndex((p: any) => {
		const postPath = (p.url || '').replace(/\/$/, '');
		return postPath === currentPath;
	});
	if (currentIndex !== -1) {
		nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
		prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f5" />
		<link rel="canonical" href={canonicalURL} />
		
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
		<meta name="twitter:creator" content="@hereticpleb" />

		<meta name="author" content="Pranav Desai" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="godObject" href={new URL("rss.xml", siteURL)} />

		<title>{isHome ? 'godObject · Pranav Desai' : `${pageTitle} · godObject`}</title>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>

		<main id="main-content">
			<header class="site-header">
				<div class="site-brand-group">
					<a href="/" class="site-brand">godObject</a>
					<span class="site-byline">· by Pranav Desai</span>
				</div>
				<nav class="site-nav-links" aria-label="Main navigation">
					<a href="https://github.com/PranavDesai-Git" target="_blank" rel="noopener noreferrer">GitHub</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="https://www.linkedin.com/in/pranav-desai-542961385/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="https://x.com/hereticpleb" target="_blank" rel="noopener noreferrer">X</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="/rss.xml">RSS</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="/privacy">Privacy</a>
				</nav>
			</header>

			{frontmatter && (
				<nav aria-label="Breadcrumb">
					<a href="/" class="back-link">← All posts</a>
				</nav>
			)}

			{frontmatter && (
				<header class="article-header">
					<h1 class="article-title">
						{frontmatter.title}
						{frontmatter.draft && <span class="draft-badge">Draft</span>}
					</h1>
					<div class="article-meta">
						<a href="https://www.linkedin.com/in/pranav-desai-542961385/" target="_blank" rel="noopener noreferrer">Pranav Desai</a>
						<span>·</span>
						<time datetime={new Date(frontmatter.date).toISOString()}>
							{new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
						</time>
						{readingTime && (
							<>
								<span>·</span>
								<span>{readingTime} min read</span>
							</>
						)}
					</div>
				</header>
			)}

			<article class="article-content">
				<slot />
			</article>

			{frontmatter && (prevPost || nextPost) && (
				<nav class="post-nav" aria-label="Adjacent posts">
					{prevPost ? (
						<a href={prevPost.url} class="post-nav-item post-nav-prev">
							<span class="post-nav-dir">← older</span>
							<span class="post-nav-title">{prevPost.frontmatter.title}</span>
						</a>
					) : <div class="post-nav-placeholder" />}
					{nextPost ? (
						<a href={nextPost.url} class="post-nav-item post-nav-next">
							<span class="post-nav-dir">newer →</span>
							<span class="post-nav-title">{nextPost.frontmatter.title}</span>
						</a>
					) : <div class="post-nav-placeholder" />}
				</nav>
			)}

			<footer class="site-footer">
				<nav class="footer-links" aria-label="Footer navigation">
					<a href="https://github.com/PranavDesai-Git" target="_blank" rel="noopener noreferrer">GitHub</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="mailto:hereticplebeian@gmail.com">Email</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="https://www.linkedin.com/in/pranav-desai-542961385/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="/rss.xml">RSS</a>
					<span class="bullet" aria-hidden="true">·</span>
					<a href="/privacy">Privacy</a>
				</nav>
				<div class="footer-copyright">
					&copy; {new Date().getFullYear()} Pranav Desai
				</div>
			</footer>
		</main>
	</body>
</html>
