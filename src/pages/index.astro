---
import Layout from '../layouts/Layout.astro';
const postsObj = import.meta.glob('../pages/blog/*.md', { eager: true }) as Record<string, any>;
const postsRawObj = import.meta.glob('../pages/blog/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

const posts = Object.entries(postsObj).map(([path, post]) => {
	const rawContent = postsRawObj[path] || '';
	const wordCount = rawContent.trim().split(/\s+/).length || 1;
	const readingTime = Math.max(1, Math.ceil(wordCount / 200));
	return { ...post, readingTime };
});
posts.sort((a, b) => Date.parse(b.frontmatter.date || new Date()) - Date.parse(a.frontmatter.date || new Date()));

const postsByYear: Record<number, Record<number, { monthName: string; posts: any[] }>> = {};
posts.forEach((post) => {
	const date = new Date(post.frontmatter.date || new Date());
	const year = date.getFullYear();
	const monthIndex = date.getMonth();
	const monthName = date.toLocaleDateString('en-US', { month: 'long' });

	if (!postsByYear[year]) postsByYear[year] = {};
	if (!postsByYear[year][monthIndex]) postsByYear[year][monthIndex] = { monthName, posts: [] };
	postsByYear[year][monthIndex].posts.push(post);
});
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<Layout title="godObject">
	<div class="timeline-layout">
		<div class="timeline-content">
			<h1 class="sr-only">godObject - Tech Rants and Build Logs</h1>
			{years.map(year => {
				const monthIndices = Object.keys(postsByYear[year]).map(Number).sort((a, b) => b - a);
				return (
					<section id={`year-${year}`} class="year-section">
						<h2 class="year-heading">{year}</h2>
						{monthIndices.map(mIdx => {
							const monthGroup = postsByYear[year][mIdx];
							return (
								<div class="month-group">
									<h3 class="month-heading">{monthGroup.monthName}</h3>
									<div class="posts-list">
										{monthGroup.posts.map((post: any) => (
											<a href={post.url} class="timeline-post" aria-label={`Read post: ${post.frontmatter.title}`}>
												{post.frontmatter.image && (
													<div class="post-thumbnail">
														<img src={post.frontmatter.image} alt={post.frontmatter.title} loading="lazy" width="100" height="100" />
													</div>
												)}
												<div class="post-content">
													<h3>{post.frontmatter.title}</h3>
													{post.frontmatter.description && (
														<p class="post-description">{post.frontmatter.description}</p>
													)}
													<div class="post-date">
														{new Date(post.frontmatter.date || new Date()).toLocaleDateString('en-US', { weekday: 'short' })} &bull; {new Date(post.frontmatter.date || new Date()).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} &bull; {post.readingTime} min read
													</div>
												</div>
											</a>
										))}
									</div>
								</div>
							);
						})}
					</section>
				);
			})}
		</div>
	</div>
</Layout>
