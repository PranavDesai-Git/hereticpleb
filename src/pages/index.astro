---
import Layout from '../layouts/Layout.astro';

const postsObj = import.meta.glob('../pages/blog/*.md', { eager: true }) as Record<string, any>;
const postsRawObj = import.meta.glob('../pages/blog/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

const posts = Object.entries(postsObj)
	.filter(([_, post]) => import.meta.env.DEV || !post.frontmatter?.draft)
	.map(([path, post]) => {
		const rawContent = postsRawObj[path] || '';
		const wordCount = rawContent.trim().split(/\s+/).length || 1;
		const readingTime = Math.max(1, Math.ceil(wordCount / 200));
		return { ...post, readingTime };
	});

posts.sort((a, b) => Date.parse(b.frontmatter.date || new Date()) - Date.parse(a.frontmatter.date || new Date()));

const postsByYear: Record<number, any[]> = {};
posts.forEach((post) => {
	const year = new Date(post.frontmatter.date || new Date()).getFullYear();
	if (!postsByYear[year]) postsByYear[year] = [];
	postsByYear[year].push(post);
});
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<Layout title="godObject">
	<div class="home-intro">
		<p>
			Engineering, systems, and build logs by Pranav Desai.
		</p>
	</div>

	{years.map(year => (
		<section class="year-group">
			<h2 class="year-heading">{year}</h2>
			<ul class="post-list">
				{postsByYear[year].map((post: any) => (
					<li>
						<a href={post.url} class="post-row">
							<span class="post-row-title">
								{post.frontmatter.title}
								{post.frontmatter.draft && <span class="draft-badge">Draft</span>}
							</span>
							<span class="post-row-meta">
								<time datetime={new Date(post.frontmatter.date).toISOString()}>
									{new Date(post.frontmatter.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
								</time>
								<span>·</span>
								<span>{post.readingTime} min</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}
</Layout>
